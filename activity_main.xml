package com.didicalc.app

import android.accessibilityservice.AccessibilityService
import android.content.Intent
import android.view.accessibility.AccessibilityEvent
import android.view.accessibility.AccessibilityNodeInfo

class DiDiAccessibilityService : AccessibilityService() {

    companion object {
        // Mínimo precio/km para aceptar (CLP)
        const val MIN_PRICE_PER_KM = 550.0
        // Umbral km viaje para considerar "largo"
        const val LONG_TRIP_KM = 8.0
        // Mínimo excepción viaje largo
        const val EXCEPTION_MIN = 450.0

        var isRunning = false
    }

    // Último estado calculado para evitar actualizaciones innecesarias
    private var lastResult = ""

    override fun onServiceConnected() {
        super.onServiceConnected()
        isRunning = true
        // Arrancar el overlay
        val intent = Intent(this, OverlayService::class.java)
        startForegroundService(intent)
    }

    override fun onAccessibilityEvent(event: AccessibilityEvent?) {
        event ?: return

        // Solo procesar cambios de contenido y estado de ventana
        if (event.eventType != AccessibilityEvent.TYPE_WINDOW_CONTENT_CHANGED &&
            event.eventType != AccessibilityEvent.TYPE_WINDOW_STATE_CHANGED) return

        val root = rootInActiveWindow ?: return
        val allText = extractAllText(root)
        root.recycle()

        parseAndBroadcast(allText)
    }

    /**
     * Recorre el árbol de vistas y recolecta todo el texto visible
     */
    private fun extractAllText(node: AccessibilityNodeInfo): List<String> {
        val texts = mutableListOf<String>()
        traverseNode(node, texts)
        return texts
    }

    private fun traverseNode(node: AccessibilityNodeInfo, texts: MutableList<String>) {
        val text = node.text?.toString()?.trim()
        if (!text.isNullOrEmpty()) texts.add(text)

        val desc = node.contentDescription?.toString()?.trim()
        if (!desc.isNullOrEmpty() && desc != text) texts.add(desc)

        for (i in 0 until node.childCount) {
            val child = node.getChild(i) ?: continue
            traverseNode(child, texts)
            child.recycle()
        }
    }

    /**
     * Extrae km y precio del texto recolectado y envía al overlay
     */
    private fun parseAndBroadcast(texts: List<String>) {
        val fullText = texts.joinToString(" | ")

        // ── Extraer distancias en km ──────────────────────────────────────
        // Patrones: "2,3km" "2.3km" "2,3 km" "2.3 km"
        val kmPattern = Regex("""(\d+[.,]\d+)\s*km""", RegexOption.IGNORE_CASE)
        val kmMatches = kmPattern.findAll(fullText)
            .map { it.groupValues[1].replace(',', '.').toDoubleOrNull() ?: 0.0 }
            .filter { it > 0.0 && it < 100.0 }
            .toList()

        // ── Extraer precio ────────────────────────────────────────────────
        // Patrones: "$2.408" "$2408" "2.408" con contexto de precio
        // Busca el número más grande en pantalla que sea razonable como tarifa (800–99999)
        val pricePattern = Regex("""\$?\s*(\d{1,2}[.,]\d{3}|\d{4,6})""")
        val priceMatches = pricePattern.findAll(fullText)
            .mapNotNull {
                val raw = it.groupValues[1].replace(".", "").replace(",", "")
                raw.toDoubleOrNull()
            }
            .filter { it in 800.0..99999.0 }
            .toList()

        // Necesitamos al menos 2 distancias y 1 precio
        if (kmMatches.size < 2 || priceMatches.isEmpty()) {
            // Si no hay datos completos, ocultar o mostrar en espera
            sendToOverlay(null, null, null, null)
            return
        }

        val kmPickup = kmMatches[0]   // primero: distancia de recogida
        val kmTrip   = kmMatches[1]   // segundo: distancia del viaje
        val totalKm  = kmPickup + kmTrip
        val price    = priceMatches.maxOrNull() ?: return  // precio más alto visible

        val pxkm = price / totalKm

        // Evitar broadcast si no cambió
        val resultKey = "$kmPickup|$kmTrip|$price"
        if (resultKey == lastResult) return
        lastResult = resultKey

        sendToOverlay(kmPickup, kmTrip, price, pxkm)
    }

    private fun sendToOverlay(
        kmPickup: Double?,
        kmTrip: Double?,
        price: Double?,
        pxkm: Double?
    ) {
        val intent = Intent(OverlayService.ACTION_UPDATE).apply {
            setPackage(packageName)
            if (pxkm != null) {
                putExtra(OverlayService.EXTRA_PXKM, pxkm)
                putExtra(OverlayService.EXTRA_KM_PICKUP, kmPickup ?: 0.0)
                putExtra(OverlayService.EXTRA_KM_TRIP, kmTrip ?: 0.0)
                putExtra(OverlayService.EXTRA_PRICE, price ?: 0.0)
            }
        }
        sendBroadcast(intent)
    }

    override fun onInterrupt() {
        isRunning = false
    }

    override fun onDestroy() {
        super.onDestroy()
        isRunning = false
        stopService(Intent(this, OverlayService::class.java))
    }
}

<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="14dp" app:cardElevation="8dp" app:cardBackgroundColor="#E5111111">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="D" android:textColor="#f97316" android:textSize="14sp" android:textStyle="bold" android:layout_marginEnd="6dp"/>
            <TextView android:id="@+id/tv_pxkm" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="--" android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="/km" android:textColor="#888888" android:textSize="11sp"/>
        </LinearLayout>
        <TextView android:id="@+id/tv_waiting" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Esperando solicitud..." android:textColor="#666666" android:textSize="11sp" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingBottom="8dp" android:visibility="visible"/>
        <LinearLayout android:id="@+id/content_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <FrameLayout android:id="@+id/verdict_bg" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#14532d" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="5dp" android:paddingBottom="5dp">
                <TextView android:id="@+id/tv_verdict" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Acepta" android:textColor="#4ade80" android:textSize="13sp" android:textStyle="bold"/>
            </FrameLayout>
            <TextView android:id="@+id/tv_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#888888" android:textSize="11sp" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="5dp" android:paddingBottom="8dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
